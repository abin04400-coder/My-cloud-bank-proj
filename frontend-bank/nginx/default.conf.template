server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Container/load-balancer health check
    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Keep /api/... path intact when forwarding to the Node.js service.
    # Set BACKEND_URL to a reachable backend URL, e.g. http://backend:3000.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(css|js|png|jpg|jpeg|svg|ico|woff2?)$ {
        expires 1h;
        add_header Cache-Control "public";
        try_files $uri =404;
    }
}
